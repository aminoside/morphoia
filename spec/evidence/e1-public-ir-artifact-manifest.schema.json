{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoia.org/schemas/engine/e1-public-ir-artifact-manifest-1.0.schema.json",
  "title": "Morphoia Engine E1 public IR artifact manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "profile",
    "generated_at",
    "manifest_document_license",
    "hash_algorithm",
    "source_base_commit",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "const": "Morphoia Engine"
    },
    "profile": {
      "const": "e1-public-ir-core-cpu"
    },
    "generated_at": {
      "const": "2026-08-12"
    },
    "manifest_document_license": {
      "const": "CC-BY-4.0"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "source_base_commit": {
      "const": "c475288961d40bb16c4cc10a333034a247acb451"
    },
    "artifacts": {
      "type": "array",
      "minItems": 123,
      "maxItems": 123,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "license_expression",
        "source_artifact_id",
        "provenance",
        "verification_status",
        "vulnerability_analysis_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$",
          "maxLength": 1024
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_expression": {
          "enum": [
            "Apache-2.0 OR MIT",
            "CC-BY-4.0",
            "MIT"
          ]
        },
        "source_artifact_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]*$",
              "maxLength": 128
            }
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "verification_status": {
          "$ref": "#/$defs/status"
        },
        "vulnerability_analysis_status": {
          "const": "NOT_RUN"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  }
}
