{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoia.org/schemas/engine/e1-public-ir-traceability-1.0.schema.json",
  "title": "Morphoia Engine E1 public IR traceability",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "profile",
    "source_base_commit",
    "execution_environment",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "./e1-public-ir-traceability.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "e1-public-ir-core-cpu"
    },
    "source_base_commit": {
      "const": "c475288961d40bb16c4cc10a333034a247acb451"
    },
    "execution_environment": {
      "$ref": "#/$defs/execution_environment"
    },
    "entries": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "safe_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$",
      "maxLength": 1024
    },
    "command_result": {
      "type": "object",
      "required": [
        "id",
        "command",
        "status",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 128
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "execution_environment": {
      "type": "object",
      "required": [
        "os",
        "architecture",
        "compiler",
        "python",
        "commands"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "compiler": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/command_result"
          }
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "requirement_id",
        "claim",
        "status",
        "test_ids",
        "evidence",
        "reason",
        "blocking_scope"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^MOR-[A-Z]+-[0-9]{3}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "test_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "maxLength": 256
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_path"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "blocking_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "test_ids": {
                "minItems": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirement_id": {
                "const": "MOR-QA-013"
              }
            },
            "required": [
              "requirement_id"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          }
        }
      ]
    }
  }
}
