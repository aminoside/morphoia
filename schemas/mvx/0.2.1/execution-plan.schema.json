{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoia.org/schemas/mvx/0.2.1/execution-plan.schema.json",
  "title": "MVX deterministic execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "work_id_algorithm", "plan_id", "stages"],
  "properties": {
    "schema": {"const": "MVX-EXECUTION-PLAN"},
    "schema_version": {"const": "0.1.0"},
    "work_id_algorithm": {"const": "MVX-WORK-ID-SHA256-JCS-1"},
    "plan_id": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_root_sha256", "split_sha256", "source_sha256", "lineage_id",
        "profile_sha256", "config_sha256", "code_sha256", "environment_sha256",
        "phase_id", "stage_id", "split", "open_once"
      ],
      "properties": {
        "protocol_root_sha256": {"$ref": "#/$defs/sha256"},
        "split_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "lineage_id": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "phase_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1},
        "split": {
          "enum": ["none", "development", "calibration", "blind", "reserve"]
        },
        "open_once": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"split": {"const": "blind"}},
            "required": ["split"]
          },
          "then": {"properties": {"open_once": {"const": true}}}
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "identity", "required_artifacts", "depends_on_work_ids"],
      "properties": {
        "work_id": {"$ref": "#/$defs/sha256"},
        "identity": {"$ref": "#/$defs/identity"},
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactName"}
        },
        "depends_on_work_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
