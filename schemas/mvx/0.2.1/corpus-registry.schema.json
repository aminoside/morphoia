{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoia.org/schemas/mvx/0.2.1/corpus-registry.schema.json",
  "title": "MVX corpus registry record 0.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_id", "lineage_id", "leakage_group_id", "dataset",
    "source_uid", "source_uri", "creator_group", "category", "selection_stratum",
    "complexity_quantile", "source_sha256", "source_size_bytes", "source_format",
    "format_status", "licence", "licence_status", "eligibility",
    "topology_status", "split"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "object_id": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "leakage_group_id": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "source_uid": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "creator_group": {"type": ["string", "null"]},
    "category": {"type": ["string", "null"]},
    "selection_stratum": {"type": ["string", "null"]},
    "complexity_quantile": {"type": ["integer", "null"], "minimum": 0, "maximum": 9},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_size_bytes": {"type": "integer", "minimum": 0},
    "source_format": {"type": "string", "minLength": 1},
    "format_status": {"type": "string", "pattern": "^P2A_[A-Z0-9_]+$"},
    "licence": {"type": "string", "minLength": 1},
    "licence_source": {"type": ["string", "null"]},
    "licence_spdx": {"type": ["string", "null"], "minLength": 1},
    "licence_status": {
      "enum": [
        "LAWFUL_INTERNAL_USE", "REDISTRIBUTABLE", "FIXTURE_GENERATED",
        "PENDING", "NO_LAWFUL_USE"
      ]
    },
    "provenance_status": {"type": ["string", "null"], "minLength": 1},
    "eligibility": {"enum": ["ELIGIBLE", "EXCLUDED", "PENDING"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "topology_status": {"enum": ["V", "O", "N", "U", "NOT_ASSESSED"]},
    "split": {"enum": ["development", "calibration", "blind", "reserve", null]},
    "components": {"type": ["integer", "null"], "minimum": 0},
    "vertices": {"type": ["integer", "null"], "minimum": 0},
    "triangles": {"type": ["integer", "null"], "minimum": 0},
    "bbox": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6}
      ]
    },
    "fixture_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "case_id", "generator_id", "generator_version"],
      "properties": {
        "kind": {"const": "SYNTHETIC_PROTOCOL_FIXTURE"},
        "case_id": {"type": "string", "minLength": 1},
        "generator_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"eligibility": {"const": "ELIGIBLE"}}, "required": ["eligibility"]},
      "then": {
        "properties": {
          "creator_group": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "selection_stratum": {"type": "string", "minLength": 1},
          "complexity_quantile": {"type": "integer", "minimum": 0, "maximum": 9},
          "topology_status": {"enum": ["V", "O", "N", "U"]}
        }
      }
    },
    {
      "if": {"properties": {"eligibility": {"enum": ["EXCLUDED", "PENDING"]}}, "required": ["eligibility"]},
      "then": {"properties": {"split": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"selection_stratum": {"const": "fixtures_C0_C9"}},
        "required": ["selection_stratum"]
      },
      "then": {
        "required": ["fixture_exception"],
        "properties": {"licence_status": {"const": "FIXTURE_GENERATED"}}
      },
      "else": {
        "allOf": [
          {"not": {"required": ["fixture_exception"]}},
          {
            "if": {
              "properties": {"eligibility": {"const": "ELIGIBLE"}},
              "required": ["eligibility"]
            },
            "then": {
              "properties": {
                "licence_status": {"enum": ["LAWFUL_INTERNAL_USE", "REDISTRIBUTABLE"]}
              }
            }
          }
        ]
      }
    }
  ]
}
