{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoia.org/schemas/mvx/0.2.1/split.schema.json",
  "title": "MVX grouped split manifest 0.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm_id", "algorithm_version", "implementation_sha256", "protocol_root_sha256", "freeze_id", "precommit_sha256", "publication_receipt_sha256", "selection_seed_sha256", "salt_sha256", "input_records_sha256", "assignments", "counts", "deviations"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "algorithm_id": {"const": "MVX-GROUP-STRATIFIED-HMAC-2"},
    "algorithm_version": {"const": "2.0.0"},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freeze_id": {"type": "string", "pattern": "^mvx-g1-[0-9a-f]{32}$"},
    "precommit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "salt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze_cohort_sha256", "select_cohort_sha256", "select_visible_milestones_sha256", "build_split_manifest_sha256", "create_custody_release_sha256"],
      "properties": {
        "freeze_cohort_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "select_cohort_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "select_visible_milestones_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_split_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "create_custody_release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineage_id", "leakage_group_id", "split", "selection_stratum", "blind_scope", "creator_group", "source_uid"],
        "properties": {
          "lineage_id": {"type": "string", "minLength": 1},
          "leakage_group_id": {"type": "string", "minLength": 1},
          "split": {"enum": ["development", "calibration", "blind", "reserve"]},
          "selection_stratum": {"type": "string", "minLength": 1},
          "blind_scope": {"enum": ["IID", "OOD", "TRANSFER", "NONE"]},
          "creator_group": {"type": "string", "minLength": 1},
          "source_uid": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dataset": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "topology_status": {"enum": ["V", "O", "N", "U"]},
          "complexity_quantile": {"type": "integer", "minimum": 0, "maximum": 9},
          "licence": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "licence_spdx": {"type": "string", "minLength": 1},
          "license_spdx": {"type": "string", "minLength": 1},
          "licence_status": {"enum": ["LAWFUL_INTERNAL_USE", "REDISTRIBUTABLE", "FIXTURE_GENERATED"]},
          "license_status": {"enum": ["LAWFUL_INTERNAL_USE", "REDISTRIBUTABLE", "FIXTURE_GENERATED"]},
          "format_status": {"type": "string", "pattern": "^P2A_"},
          "source_uri": {"type": "string", "minLength": 1},
          "source_format": {"type": "string", "minLength": 1},
          "source_size_bytes": {"type": "integer", "minimum": 0},
          "provenance_status": {"type": "string", "minLength": 1},
          "fixture_exception": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "case_id", "generator_id", "generator_version"],
            "properties": {
              "kind": {"const": "SYNTHETIC_PROTOCOL_FIXTURE"},
              "case_id": {"type": "string", "minLength": 1},
              "generator_id": {"type": "string", "minLength": 1},
              "generator_version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "calibration", "blind", "reserve"],
      "properties": {
        "development": {"type": "integer", "minimum": 0},
        "calibration": {"type": "integer", "minimum": 0},
        "blind": {"type": "integer", "minimum": 0},
        "reserve": {"type": "integer", "minimum": 0}
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "cell", "split", "target", "observed", "observed_minus_target", "allowed_absolute_deviation", "within_bound"],
        "properties": {
          "dimension": {"enum": ["total_count", "selection_stratum", "dataset", "topology_status", "complexity_quantile", "category"]},
          "cell": {"type": "string", "minLength": 1},
          "split": {"enum": ["development", "calibration", "blind"]},
          "target": {"type": "integer", "minimum": 0},
          "observed": {"type": "integer", "minimum": 0},
          "observed_minus_target": {"type": "integer"},
          "allowed_absolute_deviation": {"type": "integer", "minimum": 0},
          "within_bound": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "assignments": {
          "items": {
            "allOf": [
              {
                "if": {"properties": {"split": {"const": "blind"}}, "required": ["split"]},
                "then": {"properties": {"blind_scope": {"enum": ["IID", "OOD", "TRANSFER"]}}}
              },
              {
                "if": {"properties": {"split": {"enum": ["development", "calibration", "reserve"]}}, "required": ["split"]},
                "then": {"properties": {"blind_scope": {"const": "NONE"}}}
              },
              {
                "if": {"properties": {"blind_scope": {"enum": ["IID", "OOD"]}}, "required": ["blind_scope"]},
                "then": {"properties": {"selection_stratum": {"const": "objaverse"}}}
              },
              {
                "if": {"properties": {"blind_scope": {"const": "TRANSFER"}}, "required": ["blind_scope"]},
                "then": {
                  "properties": {
                    "split": {"const": "blind"},
                    "selection_stratum": {"not": {"const": "objaverse"}}
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
