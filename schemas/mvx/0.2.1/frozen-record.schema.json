{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoia.org/schemas/mvx/0.2.1/frozen-record.schema.json",
  "title": "MVX selected or reserve P2a record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage_id", "leakage_group_id", "dataset", "source_uid", "source_uri",
    "creator_group", "category", "selection_stratum", "complexity_quantile",
    "source_sha256", "source_size_bytes", "source_format", "format_status",
    "licence", "licence_status", "eligibility", "topology_status",
    "forced_split", "split", "blind_scope"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "object_id": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "leakage_group_id": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "source_uid": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "creator_group": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "selection_stratum": {"type": "string", "minLength": 1},
    "complexity_quantile": {"type": "integer", "minimum": 0, "maximum": 9},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_size_bytes": {"type": "integer", "minimum": 0},
    "source_format": {"type": "string", "minLength": 1},
    "format_status": {"type": "string", "pattern": "^P2A_"},
    "licence": {"type": "string", "minLength": 1},
    "licence_source": {"type": ["string", "null"]},
    "licence_spdx": {"type": ["string", "null"]},
    "licence_status": {"enum": ["LAWFUL_INTERNAL_USE", "REDISTRIBUTABLE", "FIXTURE_GENERATED"]},
    "provenance_status": {"type": ["string", "null"]},
    "eligibility": {"const": "ELIGIBLE"},
    "exclusion_reason": {"type": ["string", "null"]},
    "topology_status": {"enum": ["V", "O", "N", "U"]},
    "forced_split": {"enum": ["blind", null]},
    "split": {"enum": ["development", "calibration", "blind", "reserve"]},
    "blind_scope": {"enum": ["IID", "OOD", "TRANSFER", "NONE"]},
    "components": {"type": ["integer", "null"], "minimum": 0},
    "vertices": {"type": ["integer", "null"], "minimum": 0},
    "triangles": {"type": ["integer", "null"], "minimum": 0},
    "bbox": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6}
      ]
    },
    "fixture_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "case_id", "generator_id", "generator_version"],
      "properties": {
        "kind": {"const": "SYNTHETIC_PROTOCOL_FIXTURE"},
        "case_id": {"type": "string", "minLength": 1},
        "generator_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"split": {"const": "blind"}}, "required": ["split"]},
      "then": {"properties": {"blind_scope": {"enum": ["IID", "OOD", "TRANSFER"]}}},
      "else": {"properties": {"blind_scope": {"const": "NONE"}}}
    }
  ]
}
